\import Logic
\import Paths
\import Function (o)
\import Data.Maybe
\import lect06

-- 1. Определите функцию swap несколькими способами

-- При помощи \cowith и доступа к полям
\func swap {A B : \Type} (p : Pair A B) : Pair B A \cowith
  | fst_ => p.snd_
  | snd_ => p.fst_

-- При помощи \new и паттерн матчинга
\func swap' {A B : \Type} (p : Pair A B) : Pair B A
  | (a, b) => \new Pair { | fst_ => b | snd_ => a }

-- При помощи \new и доступа к полям
\func swap'' {A B : \Type} (p : Pair A B) : Pair B A
  => \new Pair { | fst_ => p.snd_ | snd_ => p.fst_ }

-- 2. Докажите, что swap (swap p) = p

\func swap-involutive {A B : \Type} (p : Pair A B) : swap (swap p) = p
  => idp

-- 3. Докажите, что тип PosNat 0 пустой, а тип PosNat 1 нет

\lemma zero-isNotPos (p : PosNat 0) : Empty
  => p.p

\func one-isPos : PosNat 1
  => \new PosNat 1 ()

-- 4. Определите \record, состоящий из пар взаимно простых натуральных чисел
--    Определите тип, состоящий из натуральных чисел, взаимно простых с 60

\func divides (d n : Nat) => \Sigma (k : Nat) (d Nat.* k = n)

\record CoprimePair
  | x : Nat
  | y : Nat
  | coprime (d : Nat) : divides d x -> divides d y -> d = 1

\func coprime-60 => CoprimePair { | x => 60 }

-- 5. Закончите определение класса монад
--    Этот класс должен содержать все монадные законы и реализовывать все поля из класса функторов

\class Monad \extends Functor
  | return {A : \Type} : A -> F A
  | \infixl 2 >>= {A B : \Type} : F A -> (A -> F B) -> F B

  | left-id {A B : \Type} (a : A) (k : A -> F B) : return a >>= k = k a
  | right-id {A : \Type} (m : F A) : m >>= return = m
  | >>=-assoc {A B C : \Type} (m : F A) (k : A -> F B) (h : B -> F C)
    : m >>= (\lam x => k x >>= h) = (m >>= k) >>= h

  | fmap {A B : \Type} (f : A -> B) (m : F A)
    => m >>= (return o f)
  | fmap-id {A : \Type} (m : F A)
    => right-id m
  | fmap-comp {A B C : \Type} (f : B -> C) (g : A -> B) (m : F A)
    -- m >>= (return o (f o g)) = (m >>= (return o g)) >>= (return o f)
    -- m >>= (return o (f o g)) = m >>= (\lam x => (return o g) x >>= (return o f))
    -- m >>= (\lam x => (return o g) x >>= (return o f)) = m >>= (return o (f o g))
    -- \lam x => (return o g) x >>= (return o f) = return o (f o g)
    -- return (g a) >>= (return o f) = return (f (g a))
    => inv (path (\lam i => m >>= \lam (a : A) => left-id (g a) (return o f) @ i))
       *> >>=-assoc m (return o g) (return o f)

-- 6. Определите \instance Monad для Maybe

\instance MaybeMonad : Monad Maybe
  | return {A : \Type} (a : A) : Maybe A
    => just a
  | >>= {A B : \Type} (m : Maybe A) (k : A -> Maybe B) : Maybe B \elim m {
    | nothing => nothing
    | just a => k a
  }
  | left-id {A B : \Type} (a : A) (k : A -> Maybe B) : return a >>= k = k a
    => idp
  | right-id {A : \Type} (m : Maybe A) : m >>= return = m \elim m {
    | nothing => idp
    | just _ => idp
  }
  | >>=-assoc {A B C : \Type} (m : Maybe A) (k : A -> Maybe B) (h : B -> Maybe C)
      : m >>= (\lam x => k x >>= h) = (m >>= k) >>= h \elim m {
    | nothing => idp
    | just _ => idp
  }


-- 7. Определите \instance Monad для State и State'

\record State (S A : \Type)
  | state : S -> \Sigma S A

\data State' (S A : \Type)
  | state' (S -> \Sigma S A)

\instance StateMonad {S : \Type} : Monad (State S)
  | return {A : \Type} (a : A) : State S A
    => \new State { | state => (__, a)}
  | >>= {A B : \Type} (m : State S A) (k : A -> State S B) : State S B
    => \new State { | state => \lam s => \let (s', a) => state {m} s \in state {k a} s'}
  | left-id {A B : \Type} (a : A) (k : A -> State S B) : return a >>= k = k a
    => idp
  | right-id {A : \Type} (m : State S A) : m >>= return = m
    => idp
  | >>=-assoc {A B C : \Type} (m : State S A) (k : A -> State S B) (h : B -> State S C)
      : m >>= (\lam x => k x >>= h) = (m >>= k) >>= h
    => idp

\instance State'Monad {S : \Type} : Monad (State' S)
  | return {A : \Type} (a : A) : State' S A
    => state' (__, a)
  | >>= {A B : \Type} (m : State' S A) (k : A -> State' S B) : State' S B
    => state' \lam s => \let (s', a) => run m s \in run (k a) s'
  | left-id {A B : \Type} (a : A) (k : A -> State' S B) : return a >>= k = k a
    => run-eta (k a)
  | right-id {A : \Type} (m : State' S A) : m >>= return = m
    => run-eta m
  | >>=-assoc {A B C : \Type} (m : State' S A) (k : A -> State' S B) (h : B -> State' S C)
      : m >>= (\lam x => k x >>= h) = (m >>= k) >>= h
    => idp
\where {
  \func run {S A : \Type} (s : State' S A) : S -> \Sigma S A \elim s
    | state' f => f

  \func run-eta {S A : \Type} (s : State' S A) : state' (run s) = s \elim s
    | state' f => idp
}
