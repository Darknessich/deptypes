\import Data.Bool
\import Data.List (List, length, ::)
\import lect02 (T)
\import lect04
\open Nat (+, *)

-- 1. Напишите функцию at, которая принимает List A и натуральное число и возвращает элемент по заданому индексу
--    В общем случае эту функцию определить невозможно, т. к. индекс может быть больше, чем число элементов в списке
--    Поэтому эта функция должна дополнительно еще принимать доказательство того,
--    что индекс находится в допустимых границах, в виде T (n < length xs)

\func \infix 4 < (x y : Nat) : Bool
  | 0, 0 => false
  | 0, suc y => true
  | suc x, 0 => false
  | suc x, suc y => x < y

\func at {A : \Type} (xs : List A) (n : Nat) (p : T (n < length xs)) : A \elim xs, n, p
  | List.nil, 0, ()
  | List.nil, suc n, ()
  | :: x _, 0, _ => x
  | :: _ xs, suc n, p => at xs n p

-- 2. Реализуйте аналоги функции replicate для vec и Vec
--    (эта функция создает список заданной длины, состоящий из повторений данного элемента)

\func replicate {A : \Type} (n : Nat) (a : A) : vec A n \elim n
  | 0 => ()
  | suc n => (a, replicate n a)

\func Replicate {A : \Type} (n : Nat) (a : A) : Vec A n \elim n
  | 0 => nil
  | suc n => cons a (Replicate n a)

-- 3. Реализуйте аналоги функции map для vec и Vec

\func map {A B : \Type} (f : A -> B) (n : Nat) (xs : vec A n) : vec B n \elim n, xs
  | 0, _ => ()
  | suc n, (x, xs) => (f x, map f n xs)

\func Map {A B : \Type} (f : A -> B) {n : Nat} (xs : Vec A n) : Vec B n \elim n, xs
  | 0, nil => nil
  | suc n, cons x xs => cons (f x) (Map f xs)

-- 4. Реализуйте аналоги функции zipWith для vec и Vec
--    Функция должна принимать вектора одинаковой длины

\func zipWith {A B C : \Type} (f : A -> B -> C) (n : Nat) (xs : vec A n) (ys : vec B n) : vec C n \elim n, xs, ys
  | 0, _, _ => ()
  | suc n, (x, xs), (y, ys) => (f x y, zipWith f n xs ys)

\func ZipWith {A B C : \Type} (f : A -> B -> C) {n : Nat} (xs : Vec A n) (ys : Vec B n) : Vec C n \elim n, xs, ys
  | 0, nil, nil => nil
  | suc n, cons x xs, cons y ys => cons (f x y) (ZipWith f xs ys)

-- 5. Определите тип CTree A n полных бинарных деревьев высоты _ровно_ n,
--    которые хранят элементы только во внутренних узлах, но не в листьях
--    Высота листа равна 0

\data CTree (A : \Type) (n : Nat) \elim n
  | 0 => cleaf
  | suc n => cnode (CTree A n) A (CTree A n)

-- 6. Определите тип Tree A n бинарных деревьев высоты _не больше_ n,
--    которые хранят элементы только во внутренних узлах, но не в листьях
--    Высота листа равна 0

\data Tree (A : \Type) (n : Nat) \elim n
  | _ => leaf
  | suc n => node (Tree A n) A (Tree A n)

-- Определите функцию, возвращающую высоту дерева

\func height {A : \Type} (n : Nat) (t : Tree A n) : Fin (suc n) \elim n, t
  | _, leaf => fzero
  | suc n, node l _ r => fsuc (max (height n l) (height n r))
  \where {
    \func max {n : Nat} (x y : Fin n) : Fin n \elim n, x, y
      | suc n, fzero, y => y
      | suc n, fsuc x, fzero => fsuc x
      | suc n, fsuc x, fsuc y => fsuc (max x y)
  }

-- Optional task
-- 7. Функции Fin n -> A соответствуют спискам элементов A длины n
--    Функция, преобразующая Vec A n в Fin n -> A, была реализована на лекции
--    Реализуйте обратную функцию

\func coin {A : \Type} {n : Nat} (f : Fin n -> A) : Vec A n \elim n
  | 0 => nil
  | suc n => cons (f fzero) (coin (\lam i => f (fsuc i)))

-- Optional task
-- 8. Определите тип матриц и ряд функций над ними

-- Матрица из n строк и m столбцов
\func Mat (A : \Type) (n m : Nat) : \Type => Vec (Vec A m) n

-- Диагональная матрица с элементами e на диагонали и z на остальных позициях

\func diag {A : \Type} (z e : A) (n : Nat) : Mat A n n \elim n
  | 0 => nil
  | suc n => cons (cons e (Replicate n z)) (Map (cons z) (diag z e n))

-- Транспонирование матриц

\func transpose {A : \Type} {n m : Nat} (M : Mat A n m) : Mat A m n \elim n, M
  | 0, nil => Replicate m nil
  | suc n, cons row M => ZipWith cons row (transpose M)

-- Сложение матриц

\func matAdd {A : \Type} (add : A -> A -> A) (n m : Nat) (M N : Mat A n m) : Mat A n m
  => ZipWith (ZipWith add) M N

-- Умножение матриц
-- z ─ нейтральный элемент по сложению
\func matMul {A : \Type} (z : A) (add mul : A -> A -> A) (n m k : Nat) (M : Mat A n m) (N : Mat A m k) : Mat A n k
  => Map (\lam (row : Vec A m) => Map (\lam (col : Vec A m) => foldr add z (ZipWith mul row col)) (transpose N)) M
  \where {
    \func foldr {A B : \Type} (f : A -> B -> B) (b : B) {n : Nat} (xs : Vec A n) : B \elim n, xs
      | 0, nil => b
      | suc n, cons x xs => f x (foldr f b xs)
  }

-- 9. Определите факториал через Nat-rec

\func fac (n : Nat) : Nat => Nat-rec Nat 1 (\lam k r => suc k * r) n

-- 10. Докажите ассоциативность сложения для натуральных чисел через Nat-elim

\func +-assoc' (n m k : Nat) : (n + m) + k = n + (m + k)
  => Nat-elim (\lam k => (n + m) + k = n + (m + k)) idp (\lam _ r => pmap suc r) k

-- 11. Определите рекурсор и элиминатор для D

\data D
  | con1 Nat
  | con2 D D
  | con3 (Nat -> D)

\func D-elim (P : D -> \Type)
             (c1 : \Pi (n : Nat) -> P (con1 n))
             (c2 : \Pi (d1 d2 : D) -> P d1 -> P d2 -> P (con2 d1 d2))
             (c3 : \Pi (g : Nat -> D) -> (\Pi (n : Nat) -> P (g n)) -> P (con3 g))
             (d : D) : P d
\elim d
  | con1 n => c1 n
  | con2 d1 d2 => c2 d1 d2 (D-elim P c1 c2 c3 d1) (D-elim P c1 c2 c3 d2)
  | con3 g => c3 g (\lam n => D-elim P c1 c2 c3 (g n))

\func D-rec (P : \Type)
            (c1 : Nat -> P)
            (c2 : D -> D -> P -> P -> P)
            (c3 : (Nat -> D) -> (Nat -> P) -> P)
            (d : D) : P
  => D-elim (\lam _ => P) c1 c2 c3 d

{- Для проверки, что определения D-elim и D-rec верные, вы можете попробовать определить foo через D-rec
\func foo (d : D) : Nat
  | con1 n => n
  | con2 d1 d2 => foo d1 Nat.+ foo d2
  | con3 g => foo (g (foo (g 100)))
-}

\func foo (d : D) : Nat => D-rec Nat (\lam n => n) (\lam _ _ r1 r2 => r1 + r2) (\lam _ r => r (r 100)) d

-- 12. Определите рекурсор и элиминатор для List

\func List-elim {A : \Type} (P : List A -> \Type)
                (n : P List.nil)
                (c : \Pi (x : A) (xs : List A) -> P xs -> P (x :: xs))
                (xs : List A) : P xs
\elim xs
  | List.nil => n
  | :: x xs => c x xs (List-elim P n c xs)

\func List-rec {A : \Type} (P : \Type)
               (n : P)
               (c : A -> List A -> P -> P)
               (xs : List A) : P
  => List-elim (\lam _ => P) n c xs

-- 13. Докажите pmap при помощи паттерн матчинга с idp

\func pmap {A B : \Type} (f : A -> B) {a a' : A} (p : a = a') : f a = f a' \elim p
  | idp => idp

-- 14. Докажите pmap2 при помощи паттерн матчинга с idp

\func pmap2 {A B C : \Type} (f : A -> B -> C) {a a' : A} (p : a = a') {b b' : B} (q : b = b') : f a b = f a' b' \elim p, q
  | idp, idp => idp

-- Optional task
-- 15. У оператора J есть другая форма, которую мы будем называть Jalt
--     Докажите, что J и Jalt эквивалентны, то есть выразите одно через другое и наоборот

-- Выразите Jalt через J. Можно пользоваться только J, idp и всем, что через них выражается

\func Jalt {A : \Type} (B : \Pi (a a' : A) -> a = a' -> \Type)
           (b : \Pi (a : A) -> B a a idp)
           {a a' : A} (p : a = a') : B a a' p => J (B a) (b a) p

-- Выразите J через Jalt. Можно пользоваться только Jalt, idp и всем, что через них выражается
-- Hint:
-- a. Выразите transport через Jalt
-- b. Докажите, что тип \Sigma (x : A) (a = x) одноэлементный,
--    то есть, что для любого p : \Sigma (x : A) (a = x) верно, что (x, idp) = p
-- c. Используя эти две конструкции, легко определить J

\func transport'' {A : \Type} (B : A -> \Type) {a a' : A} (p : a = a') (b : B a) : B a'
  => Jalt (\lam x y _ => B x -> B y) (\lam _ b => b) p b

\func sigma-contr {A : \Type} {a : A} (p : \Sigma (x : A) (a = x)) : (a, idp) = {\Sigma (x : A) (a = x)} p
  => Jalt (\lam (x y : A) q => (x, idp) = {\Sigma (z : A) (x = z)} (y, q)) (\lam _ => idp) p.2

\func J' {A : \Type} {a : A} (B : \Pi (a' : A) -> a = a' -> \Type)
         (b : B a idp)
         {a' : A} (p : a = a') : B a' p
  => transport'' (\lam (s : \Sigma (x : A) (a = x)) => B s.1 s.2) (sigma-contr (a', p)) b
